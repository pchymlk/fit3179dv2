{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Student Profiles by Age Group",
    "subtitle": "Compare percentages across separate indicators"
  },
  "width": "container",
  "height": 420,
  "data": {
    "url": "data/09_age_group_indicators.csv"
  },
  "transform": [
    {
      "fold": [
        "Currently_studying_pct",
        "Has_non_school_qualification_pct",
        "Bachelor_or_above_pct",
        "Fully_engaged_work_study_pct"
      ],
      "as": ["Indicator", "Value_pct"]
    },
    {
      "calculate": "datum.Indicator === 'Currently_studying_pct' ? 'Currently studying' : datum.Indicator === 'Has_non_school_qualification_pct' ? 'Any qualification' : datum.Indicator === 'Bachelor_or_above_pct' ? 'Bachelor or above' : 'Work/study engaged'",
      "as": "Indicator_label"
    }
  ],
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 2
  },
  "encoding": {
    "x": {
      "field": "Indicator_label",
      "type": "nominal",
      "title": "Indicator",
      "sort": [
        "Currently studying",
        "Any qualification",
        "Bachelor or above",
        "Work/study engaged"
      ],
      "axis": {
        "labelAngle": -20,
        "labelLimit": 150
      }
    },
    "xOffset": {
      "field": "Age_group",
      "type": "nominal"
    },
    "y": {
      "field": "Value_pct",
      "type": "quantitative",
      "title": "Percentage (%)",
      "scale": {
        "domain": [0, 100]
      },
      "axis": {
        "tickCount": 6,
        "grid": true
      }
    },
    "color": {
      "field": "Age_group",
      "type": "nominal",
      "title": "Age group",
      "scale": {
        "domain": [
          "15–19",
          "20–24",
          "25–29",
          "30–34",
          "35–39",
          "40–44",
          "45–49",
          "50–54",
          "55–59",
          "60–64",
          "65–74"
        ],
        "range": [
          "#264653",
          "#E76F51",
          "#457B9D",
          "#8A5A44",
          "#6D597A",
          "#2A9D8F",
          "#B56576",
          "#E9C46A",
          "#355070",
          "#A44A3F",
          "#588157"
        ]
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "columns": 4,
        "title": "Age group",
        "labelLimit": 180,
        "symbolSize": 100
      }
    },
    "tooltip": [
      {
        "field": "Age_group",
        "type": "nominal",
        "title": "Age group"
      },
      {
        "field": "Indicator_label",
        "type": "nominal",
        "title": "Indicator"
      },
      {
        "field": "Value_pct",
        "type": "quantitative",
        "title": "Percentage",
        "format": ".1f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    }
  }
}