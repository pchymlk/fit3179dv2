{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 380,
  "data": {
    "url": "data/09_age_group_indicators.csv"
  },
  "transform": [
    {
      "fold": [
        "Currently_studying_pct",
        "Has_non_school_qualification_pct",
        "Bachelor_or_above_pct",
        "Fully_engaged_work_study_pct"
      ],
      "as": [
        "Indicator",
        "Value_pct"
      ]
    },
    {
      "calculate": "datum.Indicator === 'Currently_studying_pct' ? 'Currently studying' : datum.Indicator === 'Has_non_school_qualification_pct' ? 'Any qualification' : datum.Indicator === 'Bachelor_or_above_pct' ? 'Bachelor or above' : 'Work/study engaged'",
      "as": "Indicator_label"
    }
  ],
  "mark": {
    "type": "line",
    "point": {
      "filled": true,
      "size": 70
    },
    "strokeWidth": 3
  },
  "encoding": {
    "x": {
      "field": "Age_group",
      "type": "ordinal",
      "sort": [
        "15–19",
        "20–24",
        "25–29",
        "30–34",
        "35–39",
        "40–44",
        "45–49",
        "45–54",
        "50–54",
        "54-74",
        "55–59",
        "55–74",
        "54–74",
        "60–64",
        "65–74"
      ],
      "title": "Age group",
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 11
      }
    },
    "y": {
      "field": "Value_pct",
      "type": "quantitative",
      "title": "Percentage (%)",
      "scale": {
        "domain": [
          0,
          100
        ]
      },
      "axis": {
        "tickCount": 5,
        "grid": true
      }
    },
    "color": {
      "field": "Indicator_label",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Currently studying",
          "Any qualification",
          "Bachelor or above",
          "Work/study engaged"
        ],
        "range": [
          "#003F50",
          "#7E3717",
          "#A9835C",
          "#90A3AF"
        ]
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "columns": 2,
        "labelLimit": 200,
        "symbolSize": 120
      }
    },
    "strokeDash": {
      "field": "Indicator_label",
      "type": "nominal",
      "legend": null,
      "scale": {
        "domain": [
          "Currently studying",
          "Any qualification",
          "Bachelor or above",
          "Work/study engaged"
        ],
        "range": [
          [
            1,
            0
          ],
          [
            1,
            0
          ],
          [
            6,
            4
          ],
          [
            2,
            3
          ]
        ]
      }
    },
    "tooltip": [
      {
        "field": "Age_group",
        "type": "nominal",
        "title": "Age group"
      },
      {
        "field": "Indicator_label",
        "type": "nominal",
        "title": "Indicator"
      },
      {
        "field": "Value_pct",
        "type": "quantitative",
        "title": "Percentage",
        "format": ".1f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "background": "#FBF5EA"
  }
}