{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "data/11_state_profiles_long.csv"
  },
  "facet": {
    "row": {
      "field": "Metric",
      "type": "nominal",
      "title": null,
      "header": {
        "labelFontSize": 13,
        "labelFontWeight": "bold",
        "labelLimit": 300,
        "labelOrient": "top"
      }
    }
  },
  "spec": {
    "width": 380,
    "height": 145,
    "transform": [
      {
        "calculate": "format(datum.Value_pct,'.0f') + '%'",
        "as": "label"
      }
    ],
    "encoding": {
      "y": {
        "field": "Abbreviation",
        "type": "nominal",
        "title": null,
        "sort": "-x",
        "axis": {
          "labelFontSize": 11
        }
      },
      "x": {
        "field": "Value_pct",
        "type": "quantitative",
        "title": "Percentage",
        "scale": {
          "domain": [
            0,
            100
          ]
        },
        "axis": {
          "tickCount": 5,
          "grid": false
        }
      },
      "tooltip": [
        {
          "field": "State",
          "type": "nominal"
        },
        {
          "field": "Metric",
          "type": "nominal"
        },
        {
          "field": "Value_pct",
          "type": "quantitative",
          "title": "Percentage",
          "format": ".1f"
        }
      ]
    },
    "layer": [
      {
        "mark": {
          "type": "bar",
          "cornerRadiusEnd": 3,
          "color": "#003F50"
        }
      },
      {
        "mark": {
          "type": "text",
          "align": "left",
          "dx": 5,
          "fontSize": 11,
          "color": "#3F1816"
        },
        "encoding": {
          "text": {
            "field": "label",
            "type": "nominal"
          }
        }
      }
    ]
  },
  "resolve": {
    "scale": {
      "x": "shared"
    }
  },
  "config": {
    "view": {
      "stroke": null
    },
    "facet": {
      "spacing": 24
    },
    "background": "#FBF5EA"
  },
  "padding": {
    "right": 36,
    "left": 5,
    "top": 5,
    "bottom": 5
  }
}