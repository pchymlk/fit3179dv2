{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "data/11_state_profiles_long.csv"
  },
  "facet": {
    "column": {
      "field": "Metric",
      "type": "nominal",
      "title": null,
      "header": {
        "labelFontSize": 12,
        "labelFontWeight": "bold",
        "labelLimit": 260,
        "labelOrient": "top"
      }
    }
  },
  "spec": {
    "width": 200,
    "height": {
      "step": 26
    },
    "transform": [
      {
        "joinaggregate": [
          {
            "op": "max",
            "field": "Value_pct",
            "as": "vmax"
          },
          {
            "op": "min",
            "field": "Value_pct",
            "as": "vmin"
          }
        ],
        "groupby": [
          "Metric"
        ]
      }
    ],
    "encoding": {
      "y": {
        "field": "Abbreviation",
        "type": "nominal",
        "title": null,
        "sort": "-x",
        "axis": {
          "labelFontSize": 11
        }
      },
      "x": {
        "field": "Value_pct",
        "type": "quantitative",
        "title": "Percentage",
        "scale": {
          "domain": [
            0,
            100
          ]
        },
        "axis": {
          "values": [
            0,
            50,
            100
          ],
          "grid": true
        }
      },
      "tooltip": [
        {
          "field": "State",
          "type": "nominal"
        },
        {
          "field": "Metric",
          "type": "nominal"
        },
        {
          "field": "Value_pct",
          "type": "quantitative",
          "title": "Percentage",
          "format": ".1f"
        }
      ],
      "color": {
        "field": "Abbreviation",
        "type": "nominal",
        "legend": null,
        "scale": {
          "domain": [
            "NSW",
            "VIC",
            "QLD",
            "SA",
            "WA",
            "TAS",
            "NT",
            "ACT"
          ],
          "range": [
            "#003F50",
            "#7E3717",
            "#E5AA7B",
            "#90A3AF",
            "#A9835C",
            "#4A8296",
            "#3F1816",
            "#D9C6A8"
          ]
        }
      }
    },
    "layer": [
      {
        "mark": {
          "type": "bar",
          "cornerRadiusEnd": 3
        }
      },
      {
        "transform": [
          {
            "filter": "datum.Value_pct == datum.vmax || datum.Value_pct == datum.vmin"
          },
          {
            "calculate": "datum.Value_pct == datum.vmax ? '▲ top' : '▼ low'",
            "as": "tag"
          }
        ],
        "mark": {
          "type": "text",
          "align": "left",
          "dx": 6,
          "fontSize": 11,
          "fontWeight": "bold",
          "color": "#7E3717"
        },
        "encoding": {
          "text": {
            "field": "tag",
            "type": "nominal"
          },
          "color": {
            "value": "#7E3717"
          }
        }
      }
    ]
  },
  "resolve": {
    "scale": {
      "x": "shared",
      "y": "independent"
    }
  },
  "config": {
    "view": {
      "stroke": null
    },
    "facet": {
      "spacing": 44
    },
    "background": "#FBF5EA",
    "font": "Nunito",
    "axis": {
      "labelColor": "#3F1816",
      "titleColor": "#3F1816",
      "gridColor": "#E6D8C0",
      "gridOpacity": 1,
      "domainColor": "#A9835C",
      "tickColor": "#A9835C",
      "labelFont": "Nunito",
      "titleFont": "Nunito"
    },
    "legend": {
      "labelColor": "#3F1816",
      "titleColor": "#3F1816",
      "labelFont": "Nunito",
      "titleFont": "Nunito"
    }
  },
  "padding": {
    "right": 12,
    "left": 5,
    "top": 5,
    "bottom": 5
  }
}