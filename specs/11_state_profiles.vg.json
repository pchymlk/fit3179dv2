
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "data/11_state_profiles_long.csv"
  },
  "transform": [
    {
      "calculate": "toNumber(datum.Value_pct)",
      "as": "v"
    },
    {
      "calculate": "datum.Metric === 'Currently studying ages 15–74' ? '01 · Currently studying (15–74)' : datum.Metric === 'Fully engaged ages 15–24' ? '02 · Fully engaged youth (15–24)' : '03 · Year 12 or Cert III+ (20–24)'",
      "as": "Metric_short"
    },
    {
      "joinaggregate": [
        {
          "op": "mean",
          "field": "v",
          "as": "avg"
        }
      ],
      "groupby": ["Metric"]
    }
  ],
  "facet": {
    "column": {
      "field": "Metric_short",
      "type": "nominal",
      "sort": [
        "01 · Currently studying (15–74)",
        "02 · Fully engaged youth (15–24)",
        "03 · Year 12 or Cert III+ (20–24)"
      ],
      "header": {
        "title": null,
        "labelFont": "Nunito",
        "labelFontSize": 13,
        "labelFontWeight": "bold",
        "labelColor": "#3F1816",
        "labelLimit": 220,
        "labelLineHeight": 17,
        "labelOrient": "top",
        "labelPadding": 12
      }
    }
  },
  "spec": {
    "width": 270,
    "height": {
      "step": 36
    },
    "layer": [
      {
        "mark": {
          "type": "rule",
          "color": "#3F1816",
          "strokeDash": [5, 4],
          "strokeWidth": 1.5,
          "opacity": 0.8
        },
        "encoding": {
          "x": {
            "field": "avg",
            "type": "quantitative",
            "scale": {
              "zero": false,
              "nice": true
            }
          }
        }
      },
      {
        "mark": {
          "type": "point",
          "filled": true,
          "size": 150,
          "stroke": "#FBF5EA",
          "strokeWidth": 1.5
        },
        "encoding": {
          "x": {
            "field": "v",
            "type": "quantitative",
            "title": "Percentage (%)",
            "scale": {
              "zero": false,
              "nice": true
            },
            "axis": {
              "tickCount": 4,
              "format": ".0f",
              "labelFontSize": 11,
              "titleFontSize": 12,
              "grid": true,
              "gridColor": "#E6D8C0",
              "domainColor": "#A9835C",
              "tickColor": "#A9835C"
            }
          },
          "y": {
            "field": "Abbreviation",
            "type": "nominal",
            "title": null,
            "sort": [
              "ACT",
              "NSW",
              "VIC",
              "NT",
              "QLD",
              "SA",
              "WA",
              "TAS"
            ],
            "axis": {
              "labelFontSize": 12,
              "labelPadding": 8,
              "ticks": false,
              "domain": false
            }
          },
          "color": {
            "field": "Metric",
            "type": "nominal",
            "scale": {
              "domain": [
                "Currently studying ages 15–74",
                "Fully engaged ages 15–24",
                "Year 12 or Cert III+ ages 20–24"
              ],
              "range": [
                "#003F50",
                "#7E3717",
                "#A9835C"
              ]
            },
            "legend": null
          },
          "tooltip": [
            {
              "field": "State",
              "type": "nominal",
              "title": "State"
            },
            {
              "field": "Metric",
              "type": "nominal",
              "title": "Indicator"
            },
            {
              "field": "v",
              "type": "quantitative",
              "title": "Percentage",
              "format": ".1f"
            },
            {
              "field": "avg",
              "type": "quantitative",
              "title": "All-state average (%)",
              "format": ".1f"
            }
          ]
        }
      }
    ]
  },
  "resolve": {
    "scale": {
      "x": "independent",
      "y": "shared"
    }
  },
  "spacing": 32,
  "config": {
    "background": "#FBF5EA",
    "font": "Nunito",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#3F1816",
      "titleColor": "#3F1816",
      "gridColor": "#E6D8C0",
      "gridOpacity": 0.9,
      "labelFont": "Nunito",
      "titleFont": "Nunito"
    }
  }
}
