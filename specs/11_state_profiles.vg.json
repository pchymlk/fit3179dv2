{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": {
    "step": 40
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "padding": {
    "left": 4,
    "right": 8,
    "top": 8,
    "bottom": 4
  },
  "data": {
    "url": "data/11_state_profiles_long.csv"
  },
  "transform": [
    {
      "calculate": "toNumber(datum.Value_pct)",
      "as": "v"
    },
    {
      "calculate": "datum.Metric === 'Currently studying ages 15–74' ? 'Currently studying|ages 15–74' : datum.Metric === 'Fully engaged ages 15–24' ? 'Fully engaged|ages 15–24' : 'Year 12 or Cert III+|ages 20–24'",
      "as": "Metric_short"
    },
    {
      "joinaggregate": [
        {
          "op": "mean",
          "field": "v",
          "as": "avg"
        },
        {
          "op": "stdev",
          "field": "v",
          "as": "sd"
        }
      ],
      "groupby": [
        "Metric"
      ]
    },
    {
      "calculate": "datum.sd > 0 ? (datum.v - datum.avg) / datum.sd : 0",
      "as": "z"
    },
    {
      "calculate": "datum.v - datum.avg",
      "as": "diff"
    }
  ],
  "mark": {
    "type": "rect",
    "stroke": "#FBF5EA",
    "strokeWidth": 3,
    "cornerRadius": 6
  },
  "encoding": {
    "x": {
      "field": "Metric_short",
      "type": "ordinal",
      "title": null,
      "sort": [
        "Currently studying|ages 15–74",
        "Fully engaged|ages 15–24",
        "Year 12 or Cert III+|ages 20–24"
      ],
      "axis": {
        "orient": "top",
        "labelAngle": 0,
        "labelExpr": "split(datum.label, '|')",
        "labelFontSize": 12,
        "labelFontWeight": "bold",
        "labelLimit": 0,
        "labelPadding": 36,
        "ticks": false,
        "domain": false,
        "labelLineHeight": 16
      }
    },
    "y": {
      "field": "Abbreviation",
      "type": "nominal",
      "title": null,
      "sort": [
        "ACT",
        "NSW",
        "VIC",
        "NT",
        "QLD",
        "SA",
        "WA",
        "TAS"
      ],
      "axis": {
        "labelFontSize": 12,
        "labelPadding": 8,
        "ticks": false,
        "domain": false
      }
    },
    "color": {
      "field": "z",
      "type": "quantitative",
      "title": "Relative to other states",
      "scale": {
        "domain": [
          -2,
          -0.67,
          0.67,
          2
        ],
        "range": [
          "#C9D6DB",
          "#90A3AF",
          "#3F7A8E",
          "#003F50"
        ],
        "clamp": true
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "gradientLength": 240,
        "values": [
          -2,
          2
        ],
        "labelExpr": "datum.value < 0 ? 'Lower' : 'Higher'",
        "offset": 12
      }
    },
    "tooltip": [
      {
        "field": "State",
        "type": "nominal",
        "title": "State"
      },
      {
        "field": "Metric",
        "type": "nominal",
        "title": "Indicator"
      },
      {
        "field": "v",
        "type": "quantitative",
        "title": "Percentage",
        "format": ".1f"
      },
      {
        "field": "avg",
        "type": "quantitative",
        "title": "All-state average (%)",
        "format": ".1f"
      },
      {
        "field": "diff",
        "type": "quantitative",
        "title": "Difference (pp)",
        "format": "+.1f"
      }
    ]
  },
  "config": {
    "background": "#FBF5EA",
    "font": "Nunito",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#3F1816",
      "titleColor": "#3F1816",
      "labelFont": "Nunito",
      "titleFont": "Nunito"
    },
    "legend": {
      "labelColor": "#3F1816",
      "titleColor": "#3F1816",
      "labelFont": "Nunito",
      "titleFont": "Nunito"
    }
  }
}