{
  "width": 420,
  "height": 360,
  "autosize": {
    "type": "pad"
  },
  "data": {
    "url": "data/04_state_hex_positions.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Hex_x": "number",
        "Hex_y": "number"
      }
    }
  },
  "transform": [
    {
      "lookup": "Abbreviation",
      "from": {
        "data": {
          "url": "data/03_state_study_enrolment.csv",
          "format": {
            "type": "csv",
            "parse": {
              "Men_pct": "number",
              "Women_pct": "number",
              "Persons_pct": "number"
            }
          }
        },
        "key": "Abbreviation",
        "fields": [
          "State",
          "Men_pct",
          "Women_pct",
          "Persons_pct"
        ]
      }
    },
    {
      "calculate": "datum.Women_pct - datum.Men_pct",
      "as": "value"
    },
    {
      "calculate": "format(datum.value, '+.1f') + ' pp'",
      "as": "valueLabel"
    },
    {
      "calculate": "84.2 + 84.0 * toNumber(datum.Hex_x)",
      "as": "cx"
    },
    {
      "calculate": "58.6 + 96.9948448 * (toNumber(datum.Hex_y) + 0.5 * (toNumber(datum.Hex_x) % 2))",
      "as": "cy"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "value",
          "as": "vmax"
        },
        {
          "op": "min",
          "field": "value",
          "as": "vmin"
        }
      ]
    },
    {
      "calculate": "(datum.vmax - datum.vmin) > 0 ? (datum.value - datum.vmin) / (datum.vmax - datum.vmin) : 0",
      "as": "t"
    }
  ],
  "layer": [
    {
      "transform": [
        {
          "calculate": "[0,1,2,3,4,5]",
          "as": "k"
        },
        {
          "flatten": [
            "k"
          ]
        },
        {
          "calculate": "datum.cx + 53.2 * cos(datum.k * PI / 3)",
          "as": "vx"
        },
        {
          "calculate": "datum.cy + 53.2 * sin(datum.k * PI / 3)",
          "as": "vy"
        }
      ],
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": [
              "State"
            ],
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ],
      "mark": {
        "type": "line",
        "interpolate": "linear-closed",
        "filled": true
      },
      "encoding": {
        "x": {
          "field": "vx",
          "type": "quantitative",
          "scale": null,
          "axis": null
        },
        "y": {
          "field": "vy",
          "type": "quantitative",
          "scale": null,
          "axis": null
        },
        "order": {
          "field": "k",
          "type": "quantitative"
        },
        "detail": {
          "field": "State",
          "type": "nominal"
        },
        "color": {
          "field": "value",
          "type": "quantitative",
          "title": "Women minus men (pp)",
          "scale": {
            "type": "quantize",
            "range": [
              "#C9D6DB",
              "#90A3AF",
              "#3F7A8E",
              "#003F50"
            ]
          },
          "legend": {
            "orient": "none",
            "legendX": 100,
            "legendY": 376,
            "direction": "horizontal",
            "format": ".1f",
            "gradientLength": 220,
            "titleFontSize": 12
          }
        },
        "stroke": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": "#7E3717"
          },
          "value": "#FFFFFF"
        },
        "strokeWidth": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 3.5
          },
          "value": 1.5
        },
        "tooltip": [
          {
            "field": "State",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "Men_pct",
            "type": "quantitative",
            "title": "Men enrolled (%)",
            "format": ".1f"
          },
          {
            "field": "Women_pct",
            "type": "quantitative",
            "title": "Women enrolled (%)",
            "format": ".1f"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "Gap, women minus men (pp)",
            "format": "+.1f"
          },
          {
            "value": "2025",
            "type": "nominal",
            "title": "Year"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -17,
        "fontSize": 16,
        "fontWeight": "bold",
        "font": "Nunito"
      },
      "encoding": {
        "x": {
          "field": "cx",
          "type": "quantitative",
          "scale": null,
          "axis": null
        },
        "y": {
          "field": "cy",
          "type": "quantitative",
          "scale": null,
          "axis": null
        },
        "text": {
          "field": "Abbreviation",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.t >= 0.5",
            "value": "#FBF5EA"
          },
          "value": "#003F50"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": 5,
        "fontSize": 14,
        "font": "Nunito"
      },
      "encoding": {
        "x": {
          "field": "cx",
          "type": "quantitative",
          "scale": null,
          "axis": null
        },
        "y": {
          "field": "cy",
          "type": "quantitative",
          "scale": null,
          "axis": null
        },
        "text": {
          "field": "valueLabel",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.t >= 0.5",
            "value": "#FBF5EA"
          },
          "value": "#003F50"
        }
      }
    }
  ],
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "background": "#FBF5EA",
    "font": "Nunito",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#3F1816",
      "titleColor": "#3F1816",
      "gridColor": "#E6D8C0",
      "gridOpacity": 1,
      "domainColor": "#A9835C",
      "tickColor": "#A9835C",
      "labelFont": "Nunito",
      "titleFont": "Nunito"
    },
    "legend": {
      "labelColor": "#3F1816",
      "titleColor": "#3F1816",
      "labelFont": "Nunito",
      "titleFont": "Nunito"
    }
  },
  "padding": {
    "left": 4,
    "right": 4,
    "top": 4,
    "bottom": 64
  }
}