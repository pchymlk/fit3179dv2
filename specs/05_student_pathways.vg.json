{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 340,
  "data": {
    "url": "./data/05_engagement_by_remoteness.csv"
  },
  "mark": {
    "type": "bar",
    "stroke": "#FBF5EA",
    "strokeWidth": 1
  },
  "encoding": {
    "x": {
      "field": "Remoteness",
      "type": "nominal",
      "title": "Remoteness area",
      "sort": [
        "Major Cities",
        "Inner Regional",
        "Outer Regional and Remote"
      ],
      "axis": {
        "labelAngle": 0,
        "labelLimit": 160,
        "labelExpr": "datum.label === 'Outer Regional and Remote' ? ['Outer Regional','and Remote'] : datum.label"
      }
    },
    "y": {
      "field": "Percent",
      "type": "quantitative",
      "stack": "normalize",
      "title": "Share of each area",
      "axis": {
        "format": "%",
        "tickCount": 5
      }
    },
    "color": {
      "field": "Engagement_status",
      "type": "nominal",
      "title": "Engagement status",
      "scale": {
        "domain": [
          "Fully engaged",
          "Partially engaged",
          "Not engaged"
        ],
        "range": [
          "#003F50",
          "#90A3AF",
          "#E5AA7B"
        ]
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "columns": 3,
        "title": "Engagement status",
        "labelLimit": 180,
        "symbolSize": 100,
        "offset": 12
      }
    },
    "tooltip": [
      {
        "field": "Remoteness",
        "type": "nominal"
      },
      {
        "field": "Engagement_status",
        "type": "nominal"
      },
      {
        "field": "Percent",
        "type": "quantitative",
        "title": "Percentage",
        "format": ".1f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "background": "#FBF5EA"
  }
}