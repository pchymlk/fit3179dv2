
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Which Fields Saw the Biggest Enrolment Changes?",
    "subtitle": "Domestic commencing students | 2015 compared with 2024"
  },
  "width": "container",
  "height": {"step": 34},
  "data": {
    "url": "data/07_domestic_commencements_by_field.csv"
  },
  "transform": [
    {
      "filter": "datum.Year == 2015 || datum.Year == 2024"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "Commencing_domestic_students",
          "as": "Students"
        }
      ],
      "groupby": ["Year", "Field"]
    },
    {
      "pivot": "Year",
      "value": "Students",
      "groupby": ["Field"]
    },
    {
      "calculate": "isValid(datum['2015']) ? datum['2015'] : 0",
      "as": "Start"
    },
    {
      "calculate": "isValid(datum['2024']) ? datum['2024'] : 0",
      "as": "End"
    }
  ],
  "encoding": {
    "y": {
      "field": "Field",
      "type": "nominal",
      "sort": {
        "field": "End",
        "order": "descending"
      },
      "scale": {
        "paddingInner": 0.3,
        "paddingOuter": 0.2
      },
      "axis": {
        "title": null,
        "labelFontSize": 11,
        "labelLimit": 260,
        "labelPadding": 8,
        "labelColor": "#454B55",
        "ticks": false,
        "domain": false,
        "grid": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#C7CDD4",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "Start",
          "type": "quantitative",
          "scale": {
            "zero": true,
            "nice": true
          },
          "axis": {
            "orient": "bottom",
            "title": "Domestic commencing students",
            "format": ",.0f",
            "labelFontSize": 11,
            "titleFontSize": 12,
            "titlePadding": 12,
            "grid": true,
            "gridColor": "#E8EAED",
            "gridWidth": 1,
            "domain": false,
            "tickCount": 5
          }
        },
        "x2": {
          "field": "End"
        },
        "tooltip": [
          {
            "field": "Field",
            "type": "nominal",
            "title": "Field"
          },
          {
            "field": "Start",
            "type": "quantitative",
            "title": "2015 students",
            "format": ",.0f"
          },
          {
            "field": "End",
            "type": "quantitative",
            "title": "2024 students",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 115,
        "color": "#83A9C2",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "Start",
          "type": "quantitative",
          "scale": {
            "zero": true,
            "nice": true
          },
          "axis": {
            "orient": "bottom",
            "title": "Domestic commencing students",
            "format": ",.0f",
            "labelFontSize": 11,
            "titleFontSize": 12,
            "titlePadding": 12,
            "grid": true,
            "gridColor": "#E8EAED",
            "gridWidth": 1,
            "domain": false,
            "tickCount": 5
          }
        },
        "tooltip": [
          {
            "field": "Field",
            "type": "nominal",
            "title": "Field"
          },
          {
            "value": "2015",
            "title": "Year"
          },
          {
            "field": "Start",
            "type": "quantitative",
            "title": "Commencing students",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 115,
        "color": "#28745B",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "End",
          "type": "quantitative",
          "scale": {
            "zero": true,
            "nice": true
          },
          "axis": {
            "orient": "bottom",
            "title": "Domestic commencing students",
            "format": ",.0f",
            "labelFontSize": 11,
            "titleFontSize": 12,
            "titlePadding": 12,
            "grid": true,
            "gridColor": "#E8EAED",
            "gridWidth": 1,
            "domain": false,
            "tickCount": 5
          }
        },
        "tooltip": [
          {
            "field": "Field",
            "type": "nominal",
            "title": "Field"
          },
          {
            "value": "2024",
            "title": "Year"
          },
          {
            "field": "End",
            "type": "quantitative",
            "title": "Commencing students",
            "format": ",.0f"
          }
        ]
      }
    }
  ],
  "resolve": {
    "scale": {
      "x": "shared",
      "y": "shared"
    },
    "axis": {
      "x": "shared",
      "y": "shared"
    }
  },
  "config": {
    "background": "#FFFFFF",
    "view": {
      "stroke": null
    },
    "title": {
      "anchor": "start",
      "font": "Arial",
      "fontSize": 19,
      "fontWeight": 700,
      "color": "#252B36",
      "subtitleFont": "Arial",
      "subtitleFontSize": 12,
      "subtitleColor": "#687180",
      "offset": 12
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelColor": "#454B55",
      "titleColor": "#252B36",
      "titleFontWeight": 600
    },
    "legend": {
      "labelColor": "#454B55",
      "titleColor": "#252B36"
    }
  }
}
