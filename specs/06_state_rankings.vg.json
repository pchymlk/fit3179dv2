{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": {
    "step": 38
  },
  "data": {
    "url": "data/07_domestic_commencements_by_field.csv"
  },
  "transform": [
    {
      "filter": "datum.Year == 2015 || datum.Year == 2024"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "Commencing_domestic_students",
          "as": "Students"
        }
      ],
      "groupby": [
        "Year",
        "Field"
      ]
    },
    {
      "pivot": "Year",
      "value": "Students",
      "groupby": [
        "Field"
      ]
    },
    {
      "calculate": "isValid(datum['2015']) ? datum['2015'] : 0",
      "as": "Start"
    },
    {
      "calculate": "isValid(datum['2024']) ? datum['2024'] : 0",
      "as": "End"
    }
  ],
  "encoding": {
    "y": {
      "field": "Field",
      "type": "nominal",
      "sort": {
        "field": "End",
        "order": "descending"
      },
      "scale": {
        "paddingInner": 0.3,
        "paddingOuter": 0.2
      },
      "axis": {
        "title": null,
        "labelFontSize": 11,
        "labelLimit": 200,
        "labelPadding": 8,
        "labelColor": "#3F1816",
        "ticks": false,
        "domain": false,
        "grid": false,
        "labelExpr": "indexof(datum.label,'Non-award')===0 ? 'Non-award courses' : indexof(datum.label,'Agriculture')===0 ? 'Agriculture & Environment' : indexof(datum.label,'Food')===0 ? 'Food & Hospitality' : indexof(datum.label,'Engineering')===0 ? 'Engineering' : datum.label"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#D9C6A8",
        "strokeWidth": 4
      },
      "encoding": {
        "x": {
          "field": "Start",
          "type": "quantitative",
          "scale": {
            "zero": true,
            "domain": [
              0,
              125000
            ],
            "nice": false
          },
          "axis": {
            "orient": "bottom",
            "title": "Domestic commencing students",
            "format": ",.0f",
            "labelFontSize": 11,
            "titleFontSize": 12,
            "titlePadding": 12,
            "grid": true,
            "gridColor": "#E6D8C0",
            "gridWidth": 1,
            "domain": false,
            "tickCount": 5
          }
        },
        "x2": {
          "field": "End"
        },
        "tooltip": [
          {
            "field": "Field",
            "type": "nominal",
            "title": "Field"
          },
          {
            "field": "Start",
            "type": "quantitative",
            "title": "2015 students",
            "format": ",.0f"
          },
          {
            "field": "End",
            "type": "quantitative",
            "title": "2024 students",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 115,
        "color": "#90A3AF",
        "stroke": "#FBF5EA",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "Start",
          "type": "quantitative",
          "scale": {
            "zero": true,
            "domain": [
              0,
              125000
            ],
            "nice": false
          },
          "axis": {
            "orient": "bottom",
            "title": "Domestic commencing students",
            "format": ",.0f",
            "labelFontSize": 11,
            "titleFontSize": 12,
            "titlePadding": 12,
            "grid": true,
            "gridColor": "#E6D8C0",
            "gridWidth": 1,
            "domain": false,
            "tickCount": 5
          }
        },
        "tooltip": [
          {
            "field": "Field",
            "type": "nominal",
            "title": "Field"
          },
          {
            "value": "2015",
            "title": "Year"
          },
          {
            "field": "Start",
            "type": "quantitative",
            "title": "Commencing students",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 115,
        "color": "#7E3717",
        "stroke": "#FBF5EA",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "End",
          "type": "quantitative",
          "scale": {
            "zero": true,
            "domain": [
              0,
              125000
            ],
            "nice": false
          },
          "axis": {
            "orient": "bottom",
            "title": "Domestic commencing students",
            "format": ",.0f",
            "labelFontSize": 11,
            "titleFontSize": 12,
            "titlePadding": 12,
            "grid": true,
            "gridColor": "#E6D8C0",
            "gridWidth": 1,
            "domain": false,
            "tickCount": 5
          }
        },
        "tooltip": [
          {
            "field": "Field",
            "type": "nominal",
            "title": "Field"
          },
          {
            "value": "2024",
            "title": "Year"
          },
          {
            "field": "End",
            "type": "quantitative",
            "title": "Commencing students",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "calculate": "max(datum.Start,datum.End)",
          "as": "XMax"
        },
        {
          "calculate": "datum.End - datum.Start",
          "as": "Chg"
        },
        {
          "calculate": "abs(datum.Chg) < 1000 ? '' : format(datum.Chg,'+.2~s')",
          "as": "Label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "XMax",
          "type": "quantitative",
          "scale": {
            "zero": true,
            "domain": [
              0,
              125000
            ],
            "nice": false
          },
          "axis": {
            "orient": "bottom",
            "title": "Domestic commencing students",
            "format": ",.0f",
            "labelFontSize": 11,
            "titleFontSize": 12,
            "titlePadding": 12,
            "grid": true,
            "gridColor": "#E6D8C0",
            "gridWidth": 1,
            "domain": false,
            "tickCount": 5
          }
        },
        "text": {
          "field": "Label",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.Chg >= 0",
            "value": "#003F50"
          },
          "value": "#7E3717"
        }
      }
    }
  ],
  "resolve": {
    "scale": {
      "x": "shared",
      "y": "shared"
    },
    "axis": {
      "x": "shared",
      "y": "shared"
    }
  },
  "config": {
    "background": "#FBF5EA",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Nunito",
      "titleFont": "Nunito",
      "labelColor": "#3F1816",
      "titleColor": "#3F1816",
      "titleFontWeight": 600,
      "gridColor": "#E6D8C0",
      "gridOpacity": 1,
      "domainColor": "#A9835C",
      "tickColor": "#A9835C"
    },
    "legend": {
      "labelColor": "#3F1816",
      "titleColor": "#3F1816",
      "labelFont": "Nunito",
      "titleFont": "Nunito"
    },
    "font": "Nunito"
  }
}