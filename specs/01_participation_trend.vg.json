{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/cleaned_higher_education_enrolments.csv",
    "format": {
      "type": "csv"
    }
  },
  "config": {
    "background": "#FBF5EA",
    "view": {
      "stroke": null
    },
    "axis": {
      "gridColor": "#E6D8C0",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "labelColor": "#3F1816",
      "titleColor": "#3F1816",
      "gridOpacity": 1,
      "domainColor": "#A9835C",
      "tickColor": "#A9835C",
      "labelFont": "Nunito",
      "titleFont": "Nunito"
    },
    "font": "Nunito",
    "legend": {
      "labelColor": "#3F1816",
      "titleColor": "#3F1816",
      "labelFont": "Nunito",
      "titleFont": "Nunito"
    }
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": "Year",
      "axis": {
        "format": "d",
        "tickMinStep": 1
      }
    },
    "y": {
      "field": "students",
      "type": "quantitative",
      "title": "Enrolled students",
      "axis": {
        "labelExpr": "datum.value >= 1000000 ? format(datum.value / 1000000, '.1f') + 'M' : format(datum.value / 1000, '.0f') + 'K'"
      },
      "scale": {
        "zero": true
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "point": {
          "filled": true,
          "size": 75,
          "color": "#003F50"
        },
        "strokeWidth": 3,
        "color": "#003F50"
      },
      "encoding": {
        "tooltip": [
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "students",
            "type": "quantitative",
            "title": "Enrolments",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2015"
        },
        {
          "calculate": "format(datum.students/1000000,'.2f')+'M'+' in 2015'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "dy": 22,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#3F1816"
      },
      "encoding": {
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2022"
        },
        {
          "calculate": "'2022 dip: '+format(datum.students/1000000,'.2f')+'M'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "dx": 0,
        "dy": 24,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#3F1816"
      },
      "encoding": {
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2024"
        },
        {
          "calculate": "'Record high: '+format(datum.students/1000000,'.2f')+'M'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": 0,
        "dy": -16,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#7E3717"
      },
      "encoding": {
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ]
}