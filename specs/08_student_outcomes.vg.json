{
  "width": "container",
  "height": 330,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "padding": {
    "left": 8,
    "right": 16,
    "top": 8,
    "bottom": 8
  },
  "params": [
    {
      "name": "Status",
      "value": "Not in labour force",
      "bind": {
        "input": "select",
        "options": [
          "Employed full-time",
          "Employed part-time",
          "Unemployed",
          "Not in labour force"
        ],
        "name": "Labour-force status: "
      }
    }
  ],
  "data": {
    "url": "data/08_labour_force_outcomes.csv"
  },
  "transform": [
    {
      "filter": "datum.Labour_force_status === Status"
    },
    {
      "calculate": "indexof(datum.Group,'Men')===0 ? 'Men' : 'Women'",
      "as": "Sex"
    },
    {
      "calculate": "slice(datum.Group, datum.Sex==='Men' ? 4 : 6)",
      "as": "QualRaw"
    },
    {
      "calculate": "indexof(datum.QualRaw,'with bachelor')===0 ? 'Bachelor degree' : indexof(datum.QualRaw,'with certificate')===0 ? 'Certificate III/IV' : 'No non-school qualification'",
      "as": "Qual"
    },
    {
      "calculate": "toNumber(datum.Percent)",
      "as": "Pct"
    },
    {
      "calculate": "datum.Sex==='Men' ? -datum.Pct : datum.Pct",
      "as": "Signed"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "Pct",
          "as": "M"
        }
      ]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3
      },
      "encoding": {
        "x": {
          "field": "Signed",
          "type": "quantitative",
          "title": "Share of group (%)",
          "scale": {
            "nice": true,
            "zero": true
          },
          "axis": {
            "labelExpr": "abs(datum.value)",
            "tickCount": 6,
            "grid": true
          }
        },
        "y": {
          "field": "Qual",
          "type": "nominal",
          "title": null,
          "sort": [
            "Bachelor degree",
            "Certificate III/IV",
            "No non-school qualification"
          ],
          "scale": {
            "paddingInner": 0.35
          },
          "axis": {
            "labelFontSize": 12,
            "labelPadding": 10,
            "ticks": false,
            "domain": false,
            "labelLimit": 220
          }
        },
        "tooltip": [
          {
            "field": "Sex",
            "type": "nominal",
            "title": "Sex"
          },
          {
            "field": "Qual",
            "type": "nominal",
            "title": "Qualification"
          },
          {
            "field": "Labour_force_status",
            "type": "nominal",
            "title": "Labour-force status"
          },
          {
            "field": "Pct",
            "type": "quantitative",
            "title": "Percentage",
            "format": ".1f"
          }
        ],
        "color": {
          "field": "Sex",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Men",
              "Women"
            ],
            "range": [
              "#003F50",
              "#7E3717"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "symbolSize": 120,
            "labelFontSize": 12
          }
        }
      }
    },
    {
      "transform": [
        {
          "calculate": "[-datum.M, datum.M]",
          "as": "Ext"
        },
        {
          "flatten": [
            "Ext"
          ]
        }
      ],
      "mark": {
        "type": "point",
        "opacity": 0
      },
      "encoding": {
        "x": {
          "field": "Ext",
          "type": "quantitative",
          "scale": {
            "nice": true,
            "zero": true
          }
        },
        "y": {
          "field": "Qual",
          "type": "nominal",
          "title": null,
          "sort": [
            "Bachelor degree",
            "Certificate III/IV",
            "No non-school qualification"
          ],
          "scale": {
            "paddingInner": 0.35
          },
          "axis": {
            "labelFontSize": 12,
            "labelPadding": 10,
            "ticks": false,
            "domain": false,
            "labelLimit": 220
          }
        }
      }
    }
  ],
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "background": "#FBF5EA",
    "font": "Nunito",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#3F1816",
      "titleColor": "#3F1816",
      "gridColor": "#E6D8C0",
      "gridOpacity": 1,
      "domainColor": "#A9835C",
      "tickColor": "#A9835C",
      "labelFont": "Nunito",
      "titleFont": "Nunito"
    },
    "legend": {
      "labelColor": "#3F1816",
      "titleColor": "#3F1816",
      "labelFont": "Nunito",
      "titleFont": "Nunito"
    }
  }
}