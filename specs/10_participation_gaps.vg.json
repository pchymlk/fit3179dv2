{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Gender Gap in Study Participation",
    "subtitle": "Currently enrolled in study, by age group, 2025"
  },
  "width": "container",
  "height": 400,
  "data": {
    "url": "data/10_study_participation_gender_gap.csv"
  },
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 2
  },
  "encoding": {
    "x": {
      "field": "Sex",
      "type": "nominal",
      "title": "Sex",
      "sort": ["Men", "Women"],
      "axis": {
        "labelFontSize": 13
      }
    },
    "xOffset": {
      "field": "Age_group",
      "type": "nominal"
    },
    "y": {
      "field": "Currently_studying_pct",
      "type": "quantitative",
      "title": "Currently studying (%)",
      "scale": {
        "domain": [0, 100]
      },
      "axis": {
        "tickCount": 6,
        "grid": true
      }
    },
    "color": {
      "field": "Age_group",
      "type": "nominal",
      "title": "Age group",
      "scale": {
        "domain": [
          "15–19",
          "20–24",
          "25–29",
          "30–34",
          "35–39",
          "40–44",
          "45–54",
          "54-74"
        ],
        "range": [
          "#264653",
          "#E76F51",
          "#457B9D",
          "#8A5A44",
          "#6D597A",
          "#2A9D8F",
          "#B56576",
          "#E9C46A"
        ]
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "columns": 4,
        "title": "Age group",
        "labelFontSize": 11,
        "symbolSize": 90
      }
    },
    "tooltip": [
      {
        "field": "Sex",
        "type": "nominal",
        "title": "Sex"
      },
      {
        "field": "Age_group",
        "type": "nominal",
        "title": "Age group"
      },
      {
        "field": "Currently_studying_pct",
        "type": "quantitative",
        "title": "Currently studying (%)",
        "format": ".1f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    }
  }
}