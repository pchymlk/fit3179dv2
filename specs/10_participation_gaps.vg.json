{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 400,
  "data": {
    "url": "data/10_study_participation_gender_gap.csv"
  },
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 2
  },
  "encoding": {
    "x": {
      "field": "Age_group",
      "type": "nominal",
      "title": "Age group",
      "sort": [
        "15–19",
        "20–24",
        "25–29",
        "30–34",
        "35–39",
        "40–44",
        "45–49",
        "45–54",
        "50–54",
        "54-74",
        "55–59",
        "55–74",
        "54–74",
        "60–64",
        "65–74"
      ],
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 11
      }
    },
    "xOffset": {
      "field": "Sex",
      "type": "nominal",
      "sort": [
        "Men",
        "Women"
      ]
    },
    "y": {
      "field": "Currently_studying_pct",
      "type": "quantitative",
      "title": "Currently studying (%)",
      "scale": {
        "domain": [
          0,
          100
        ]
      },
      "axis": {
        "tickCount": 5,
        "grid": true
      }
    },
    "color": {
      "field": "Sex",
      "type": "nominal",
      "title": null,
      "sort": [
        "Men",
        "Women"
      ],
      "scale": {
        "domain": [
          "Men",
          "Women"
        ],
        "range": [
          "#003F50",
          "#7E3717"
        ]
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "symbolSize": 120,
        "labelFontSize": 12
      }
    },
    "tooltip": [
      {
        "field": "Sex",
        "type": "nominal",
        "title": "Sex"
      },
      {
        "field": "Age_group",
        "type": "nominal",
        "title": "Age group"
      },
      {
        "field": "Currently_studying_pct",
        "type": "quantitative",
        "title": "Currently studying (%)",
        "format": ".1f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "background": "#FBF5EA"
  }
}