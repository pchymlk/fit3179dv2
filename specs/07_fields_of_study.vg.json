
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "How Student Choices Have Shifted",
    "subtitle": "Domestic commencing enrolments by broad field, 2015–2024"
  },
  "width": "container",
  "height": 380,
  "data": {
    "url": "data/07_domestic_commencements_by_field.csv"
  },
  "mark": {
    "type": "area",
    "interpolate": "monotone",
    "opacity": 0.82
  },
  "encoding": {
    "x": {
      "field": "Year",
      "type": "quantitative",
      "title": "Year",
      "axis": {
        "format": "d",
        "tickMinStep": 1
      }
    },
    "y": {
      "field": "Commencing_domestic_students",
      "type": "quantitative",
      "stack": "center",
      "title": "Commencements",
      "axis": {
        "format": "~s"
      }
    },
    "color": {
      "field": "Field",
      "type": "nominal",
      "title": "Field of education",
      "scale": {
        "domain": [
          "Agriculture, Environmental and Related Sciences",
          "Architecture and Building",
          "Creative Arts",
          "Education",
          "Engineering and Related Technologies",
          "Food, Hospitality and Personal Services",
          "Health",
          "Information Technology",
          "Management and Commerce",
          "Mixed Field Programmes",
          "Natural and Physical Sciences",
          "Non-award courses(3.04)",
          "Society and Culture"
        ],
        "range": [
          "#24476B",
          "#477DA8",
          "#9B83B8",
          "#58A6A6",
          "#347C78",
          "#E5B45E",
          "#7664A8",
          "#D49A64",
          "#8C7666",
          "#A7A7A7",
          "#355F8A",
          "#D4B9D8",
          "#287D8E"
        ]
      }
    },
    "detail": {
      "field": "Field"
    },
    "order": {
      "field": "Field",
      "type": "nominal"
    },
    "tooltip": [
      {
        "field": "Year",
        "type": "quantitative",
        "title": "Year",
        "format": "d"
      },
      {
        "field": "Field",
        "type": "nominal",
        "title": "Field of education"
      },
      {
        "field": "Commencing_domestic_students",
        "type": "quantitative",
        "title": "Commencements",
        "format": ",.0f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    }
  }
}
