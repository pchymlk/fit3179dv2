{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 430,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "projection": {
    "type": "mercator"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Nunito",
      "subtitleFont": "Nunito"
    },
    "background": "#FBF5EA",
    "font": "Nunito",
    "axis": {
      "labelColor": "#3F1816",
      "titleColor": "#3F1816",
      "gridColor": "#E6D8C0",
      "gridOpacity": 1,
      "domainColor": "#A9835C",
      "tickColor": "#A9835C",
      "labelFont": "Nunito",
      "titleFont": "Nunito"
    },
    "legend": {
      "labelColor": "#3F1816",
      "titleColor": "#3F1816",
      "labelFont": "Nunito",
      "titleFont": "Nunito"
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/australian_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "australian_states"
        }
      },
      "transform": [
        {
          "lookup": "properties.STE_NAME21",
          "from": {
            "data": {
              "url": "data/cleaned_work_study_engagement_by_state.csv",
              "format": {
                "type": "csv"
              }
            },
            "key": "State",
            "fields": [
              "Engaged_pct"
            ]
          }
        },
        {
          "filter": "isValid(datum.Engaged_pct)"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.5
      },
      "encoding": {
        "color": {
          "field": "Engaged_pct",
          "type": "quantitative",
          "title": "Fully engaged (%)",
          "scale": {
            "domain": [
              75,
              78,
              81,
              85
            ],
            "range": [
              "#C9D6DB",
              "#90A3AF",
              "#3F7A8E",
              "#003F50"
            ],
            "clamp": true
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "title": "Fully engaged (%)",
            "format": ".0f",
            "gradientLength": 220,
            "offset": 12
          }
        },
        "tooltip": [
          {
            "field": "properties.STE_NAME21",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "properties.AUS_NAME21",
            "type": "nominal",
            "title": "Country"
          },
          {
            "value": "2025",
            "type": "nominal",
            "title": "Year"
          },
          {
            "value": "15–24 years",
            "type": "nominal",
            "title": "Age group"
          },
          {
            "field": "Engaged_pct",
            "type": "quantitative",
            "title": "Fully engaged (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 149.4,
            "lat": -42.3
          }
        ]
      },
      "mark": {
        "type": "text",
        "text": [
          "Tasmania:",
          "lowest, ≈75%"
        ],
        "align": "left",
        "dx": 8,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#7E3717",
        "lineHeight": 14
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "url": "data/cleaned_work_study_engagement_by_state.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "lookup": "State",
          "from": {
            "data": {
              "values": [
                {
                  "State": "New South Wales",
                  "abbr": "NSW",
                  "lon": 147.0,
                  "lat": -32.2
                },
                {
                  "State": "Victoria",
                  "abbr": "VIC",
                  "lon": 144.7,
                  "lat": -36.7
                },
                {
                  "State": "Queensland",
                  "abbr": "QLD",
                  "lon": 144.5,
                  "lat": -22.6
                },
                {
                  "State": "South Australia",
                  "abbr": "SA",
                  "lon": 135.8,
                  "lat": -30.1
                },
                {
                  "State": "Western Australia",
                  "abbr": "WA",
                  "lon": 122.2,
                  "lat": -25.5
                },
                {
                  "State": "Northern Territory",
                  "abbr": "NT",
                  "lon": 133.4,
                  "lat": -19.5
                }
              ]
            },
            "key": "State",
            "fields": [
              "abbr",
              "lon",
              "lat"
            ]
          }
        },
        {
          "filter": "isValid(datum.abbr)"
        },
        {
          "calculate": "toNumber(datum.Engaged_pct)",
          "as": "v"
        },
        {
          "calculate": "datum.abbr",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -7,
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.v >= 80",
            "value": "#FBF5EA"
          },
          "value": "#3F1816"
        }
      }
    },
    {
      "data": {
        "url": "data/cleaned_work_study_engagement_by_state.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "lookup": "State",
          "from": {
            "data": {
              "values": [
                {
                  "State": "New South Wales",
                  "abbr": "NSW",
                  "lon": 147.0,
                  "lat": -32.2
                },
                {
                  "State": "Victoria",
                  "abbr": "VIC",
                  "lon": 144.7,
                  "lat": -36.7
                },
                {
                  "State": "Queensland",
                  "abbr": "QLD",
                  "lon": 144.5,
                  "lat": -22.6
                },
                {
                  "State": "South Australia",
                  "abbr": "SA",
                  "lon": 135.8,
                  "lat": -30.1
                },
                {
                  "State": "Western Australia",
                  "abbr": "WA",
                  "lon": 122.2,
                  "lat": -25.5
                },
                {
                  "State": "Northern Territory",
                  "abbr": "NT",
                  "lon": 133.4,
                  "lat": -19.5
                }
              ]
            },
            "key": "State",
            "fields": [
              "abbr",
              "lon",
              "lat"
            ]
          }
        },
        {
          "filter": "isValid(datum.abbr)"
        },
        {
          "calculate": "toNumber(datum.Engaged_pct)",
          "as": "v"
        },
        {
          "calculate": "format(datum.v,'.1f') + '%'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "dy": 7,
        "fontSize": 11,
        "fontWeight": "normal"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.v >= 80",
            "value": "#FBF5EA"
          },
          "value": "#3F1816"
        }
      }
    },
    {
      "data": {
        "url": "data/cleaned_work_study_engagement_by_state.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "filter": "datum.State == 'Australian Capital Territory'"
        },
        {
          "calculate": "'ACT: ' + format(toNumber(datum.Engaged_pct),'.1f') + '%'",
          "as": "label"
        },
        {
          "calculate": "151.9",
          "as": "lon"
        },
        {
          "calculate": "-35.9",
          "as": "lat"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#003F50"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ]
}