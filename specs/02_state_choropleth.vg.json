
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Young Australians Fully Engaged in Work and/or Study",
    "subtitle": "People aged 15–24, by state and territory | 2025",
    "anchor": "middle",
    "fontSize": 17,
    "subtitleFontSize": 12,
    "offset": 12
  },
  "width": "container",
  "height": 430,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "projection": {
    "type": "mercator",
    "fit": {
      "data": {
        "url": "data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "States and Territories"
        }
      }
    }
  },
  "data": {
    "url": "data/australia_states.topojson",
    "format": {
      "type": "topojson",
      "feature": "States and Territories"
    }
  },
  "transform": [
    {
      "lookup": "properties.STE_NAME21",
      "from": {
        "data": {
          "url": "data/cleaned_work_study_engagement_by_state.csv",
          "format": {
            "type": "csv"
          }
        },
        "key": "State",
        "fields": [
          "Engaged_pct"
        ]
      }
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "#FFFFFF",
    "strokeWidth": 1.5
  },
  "encoding": {
    "color": {
      "field": "Engaged_pct",
      "type": "quantitative",
      "title": "Fully engaged (%)",
      "scale": {
        "domain": [75, 85],
        "scheme": "tealblues",
        "clamp": true
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "title": "Fully engaged (%)",
        "format": ".1f",
        "gradientLength": 220,
        "offset": 12
      }
    },
    "tooltip": [
      {
        "field": "properties.STE_NAME21",
        "type": "nominal",
        "title": "State or territory"
      },
      {
        "field": "Engaged_pct",
        "type": "quantitative",
        "title": "Fully engaged",
        "format": ".1f"
      }
    ]
  },
  "config": {
    "background": "#FFFFFF",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Nunito",
      "subtitleFont": "Nunito"
    }
  }
}
